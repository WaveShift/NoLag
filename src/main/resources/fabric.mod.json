{
  "schemaVersion": 1,
  "id": "nolag",
  "version": "${version}",
  "name": "NoLag",
  "description": "Hides selected vanilla visuals: death animations, poof particles, zombified piglins, and nether portal blocks/particles. Client-side only.",
  "authors": [
    "meowjade",
    "1.21.4 port: WaveShift"
  ],
  "contact": {
    "repo": "https://github.com/WaveShift/NoLag"
  },
  "license": "GPL-3.0-only",
  "environment": "*",
  "entrypoints": {
    "client": [
      "org.jade.nolag.ModClient"
    ],
    "modmenu": [
      "org.jade.nolag.ModMenuIntegration"
    ]
  },
  "mixins": [
    "nolag.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}"
  },
  "custom": {
    "fabric-renderer-api-v1:contains_renderer": true,
    "modmenu": {
    }
  }
}
